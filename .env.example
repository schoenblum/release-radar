# Release Radar configuration.
#
# Create your .env with fresh secrets:   python3 scripts/generate_env.py
# Never commit .env. This file holds placeholders only.

# Which Compose services run: dev, prod, or prod,proxy.
COMPOSE_PROFILES=dev

ENVIRONMENT=development
# The address people use. In development that is the Vite server. An https://
# address also marks the session cookie Secure and turns on HSTS.
BASE_URL=http://localhost:5173

# Database. DATABASE_URL is assembled from these in compose.yaml.
POSTGRES_USER=release_radar
POSTGRES_DB=release_radar
POSTGRES_PASSWORD=change-me

# Secrets. HANDOVER section 7 has the rotation procedures.
SECRET_KEY=change-me
FERNET_KEY=change-me
# FERNET_KEYS=old-key-1,old-key-2
BACKUP_PASSPHRASE=change-me

# First admin. Used only while the database has no admin. A new password is
# required at first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Institution. Used once, when the row is first created.
INSTITUTION_NAME_EN=My institution
INSTITUTION_NAME_JA=
INSTITUTION_TIMEZONE=Asia/Tokyo

# Email. SMTP_SECURITY is starttls, ssl or none. In development the app-dev
# service overrides these to use Mailpit (http://localhost:8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Folders on the host, mounted into the app container.
# Brand pack: a folder with theme.json, logos and optional fonts.
BRAND_PACK_HOST_PATH=./app/brand_default
# Backups: the NAS share in production.
BACKUP_HOST_PATH=./data/backups
BACKUP_RETENTION_DAYS=14
# Hour of the nightly backup, in the institution's time zone.
BACKUP_HOUR=3

# Where the production app listens. Keep 127.0.0.1 when the proxy profile is
# used. For direct access from the office network, use the host's address.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
UVICORN_WORKERS=2

# Proxy profile only. Set FORWARDED_ALLOW_IPS=* so rate limits see real client
# addresses, and SITE_ADDRESS to the host name.
# FORWARDED_ALLOW_IPS=*
# SITE_ADDRESS=radar.example.org

# Set to e.g. 30 to verify single-firing after a deploy (HANDOVER section 9).
SCHEDULER_TEST_INTERVAL_SECONDS=0
